#!/usr/bin/env sh

mkdir -p ~/.config/hypr
mkdir -p ~/.config/kitty
mkdir -p ~/.config/mango
mkdir -p ~/.config/sway

touch ~/.config/hypr/local.conf
touch ~/.config/kitty/local.conf
touch ~/.config/mango/local.conf
touch ~/.config/sway/local

mkdir -p ~/.config/niri/dms
for f in colors cursor layout alttab binds; do touch ~/.config/niri/dms/"$f".kdl; done
touch ~/.config/niri/local.kdl

mkdir -p ~/.config/hypr/dms
for f in colors cursor layout outputs; do touch ~/.config/hypr/dms/"$f".conf; done

mkdir -p ~/.config/mango/dms
for f in colors cursor layout outputs; do touch ~/.config/mango/dms/"$f".conf; done

touch ~/.config/sway/noctalia
touch ~/.config/mango/noctalia.conf
