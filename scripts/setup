#!/usr/bin/env bash

set -Eeuo pipefail

EXIT_CODE=0

trap 'handle_error $? $LINENO' ERR
trap 'handle_exit' EXIT

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

handle_error() {
  local error_code="$1"
  local line_number="$2"
  echo -e "${RED}✗ Error on line ${line_number}: Command exited with status ${error_code}${NC}" >&2
  EXIT_CODE="$error_code"
  exit "$error_code"
}

handle_exit() {
  if [ "$EXIT_CODE" -ne 0 ]; then
    echo -e "${RED}=== Setup Failed ===${NC}"
  fi
}

HOSTNAME=""

has_cmd() {
  command -v "$1" &>/dev/null
}

dir_exists() {
  [ -d "$1" ]
}

log() {
  echo -e "${GREEN}✓ $1${NC}"
}

warn() {
  echo -e "${YELLOW}⚠ $1${NC}"
}

error() {
  echo -e "${RED}✗ $1${NC}" >&2
}

log_step() {
  echo -e "${YELLOW}$1${NC}"
}

die() {
  error "$1"
  EXIT_CODE=1
  exit 1
}

run_cmd() {
  local cmd="$1"
  shift
  nix run --experimental-features 'nix-command flakes' "nixpkgs#$cmd" -- "$@"
}

print_help() {
  echo "NixOS Config Setup Script"
  echo ""
  echo "Usage: setup [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  --help, -h    Show this help message"
  echo ""
  echo "This script sets up a NixOS configuration by:"
  echo "  1. Cloning nix-config repository"
  echo "  2. Generating vars.nix"
  echo "  3. Creating a host directory, copying NixOS config, and staging"
  echo "  4. Rebuilding NixOS with the new configuration"
}

NIX_CONFIG_DIR="${HOME}/.nix-config"

clone_repository() {
  log_step "Step 1: Cloning nix-config repository..."

  if dir_exists "${NIX_CONFIG_DIR}/.git"; then
    warn "Repository already exists, skipping clone"
    cd "${NIX_CONFIG_DIR}"
    return 0
  fi

  if ! has_cmd nix; then
    die "nix is not installed. Please install Nix first."
  fi

  if ! run_cmd git clone --depth 1 https://github.com/pervezfunctor/nix-config.git "${NIX_CONFIG_DIR}"; then
    die "Failed to clone repository"
  fi

  cd "${NIX_CONFIG_DIR}"
  log "Repository cloned successfully"
}

check_prerequisites() {
  log_step "Checking prerequisites..."

  if [ ! -f "flake.nix" ]; then
    die "flake.nix not found. Please run this script from the ~/.nix-config root directory."
  fi

  if ! has_cmd nixos-rebuild; then
    die "nixos-rebuild is not available. Please run this script on a NixOS system."
  fi

  HOSTNAME=$(hostname) || die "Failed to get hostname"

  if [ -z "$HOSTNAME" ]; then
    die "Hostname is empty"
  fi

  log "Prerequisites check passed (hostname: ${HOSTNAME})"
}

generate_vars() {
  log_step "Step 2: Generating vars.nix..."

  [ -n "${USER:-}" ] || die "USER is empty"
  [ -n "$HOSTNAME" ] || die "HOSTNAME is empty"

  cat >vars.nix <<EOF
{
  username = "${USER}";
  homeDirectory = "${HOME}";
  hostname = "${HOSTNAME}";
}
EOF

  log "vars.nix generated"
}

setup_host_directory() {
  local host_dir="hosts/${HOSTNAME}"

  log_step "Step 3: Setting up host directory for '${HOSTNAME}'..."

  if ! dir_exists "$host_dir"; then
    mkdir -p "$host_dir" || die "Failed to create host directory: $host_dir"

    if dir_exists "/etc/nixos"; then
      cp "/etc/nixos/configuration.nix" "$host_dir/"
      cp "/etc/nixos/hardware-configuration.nix" "$host_dir/"
      log "NixOS configuration copied to $host_dir"
    else
      die "/etc/nixos not found, skipping config copy"
    fi
  fi

  if ! run_cmd git add .; then
    die "Failed to stage changes"
  fi

  log "Host directory setup complete: $host_dir"
}

rebuild_nixos() {
  log_step "Step 4: Rebuilding NixOS configuration..."

  if ! nix eval ".#nixosConfigurations.${HOSTNAME}" &>/dev/null; then
    warn "No '${HOSTNAME}' entry in flake.nix nixosConfigurations"
    echo "Add this to flake.nix:"
    echo "  ${HOSTNAME} = mkMin ./hosts/${HOSTNAME}/configuration.nix;"
    echo "Then run: sudo nixos-rebuild switch --flake .#${HOSTNAME}"
    return 0
  fi

  echo "This requires sudo privileges and may take a while..."
  read -p "Rebuild NixOS with '--flake .#${HOSTNAME}'? (y/N) " -n 1 -r
  echo
  [[ ! $REPLY =~ ^[Yy]$ ]] && {
    log "Skipping rebuild"
    return 0
  }

  if ! sudo nixos-rebuild switch --flake ".#${HOSTNAME}"; then
    die "NixOS rebuild failed"
  fi

  log "NixOS rebuild complete"
}

main() {
  echo -e "${GREEN}=== NixOS Config Setup ===${NC}\n"

  clone_repository
  check_prerequisites
  generate_vars
  setup_host_directory

  log_step "Step 4: Labeling boot partition..."
  read -p "Label /dev/vda1 as BOOT for by-label disk references? (y/N) " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    sudo fatlabel /dev/vda1 BOOT
    log "Boot partition labeled"
  else
    warn "Skipping boot partition labeling"
  fi

  rebuild_nixos

  echo ""
  echo -e "${GREEN}=== Setup Complete ===${NC}"
  echo "Your NixOS configuration is now ready!"
  echo "Remember to reboot your system and commit your changes to a new repository."
}

while [[ $# -gt 0 ]]; do
  case $1 in
  --help | -h | help)
    print_help
    exit 0
    ;;
  *)
    echo "Unknown option: $1"
    echo "Use --help for usage information"
    exit 1
    ;;
  esac
done

main
