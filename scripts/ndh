#!/usr/bin/env bash
# Nix Darwin/Home-Manager/NixOS deployment helper
# Usage: ndh [flake_path]   (defaults to current directory)
set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") [flake_path] [-h|--help|help]

Pick a NixOS, nix-darwin or Home Manager configuration from the flake with
fzf and switch to it. flake_path defaults to the current directory.
EOF
}

case "${1:-}" in
-h | --help | help)
  usage
  exit 0
  ;;
esac

FLAKE_PATH="${1:-.}"

require() {
  command -v "$1" >/dev/null || {
    echo "Missing dependency: $1" >&2
    exit 1
  }
}

require nix
require jq
require fzf

# Print the attribute names of a flake output, one per line.
# Only names are evaluated; evaluating whole configurations as JSON fails.
attr_names() {
  nix eval --json "${FLAKE_PATH}#$1" --apply builtins.attrNames 2>/dev/null | jq -r '.[]'
}

declare -A TARGETS=(
  [nixos]=nixosConfigurations
  [darwin]=darwinConfigurations
  [home]=homeConfigurations
)

mapfile -t TYPES < <(
  for type in "${!TARGETS[@]}"; do
    if nix eval "${FLAKE_PATH}#${TARGETS[$type]}" --apply 'x: true' >/dev/null 2>&1; then
      echo "$type"
    fi
  done | sort
)

if [[ ${#TYPES[@]} -eq 0 ]]; then
  echo "No supported flake outputs found in ${FLAKE_PATH}" >&2
  exit 1
fi

TYPE=$(printf '%s\n' "${TYPES[@]}" | fzf --prompt="Config type ❯ ") || exit 0
[[ -z "$TYPE" ]] && exit 0

ATTR="${TARGETS[$TYPE]}"

if ! NAMES_RAW=$(attr_names "$ATTR"); then
  echo "Failed to evaluate ${ATTR}" >&2
  exit 1
fi
mapfile -t NAMES <<<"$NAMES_RAW"

if [[ -z "${NAMES[0]:-}" ]]; then
  echo "No targets found for ${TYPE}" >&2
  exit 1
fi

NAME=$(printf '%s\n' "${NAMES[@]}" | fzf --prompt="${TYPE} target ❯ ") || exit 0
[[ -z "$NAME" ]] && exit 0

case "$TYPE" in
  nixos)
    echo "Deploying NixOS configuration: ${NAME}"
    exec sudo nixos-rebuild switch --flake "${FLAKE_PATH}#${NAME}"
    ;;
  darwin)
    require darwin-rebuild
    echo "Deploying Darwin configuration: ${NAME}"
    exec darwin-rebuild switch --flake "${FLAKE_PATH}#${NAME}"
    ;;
  home)
    require home-manager
    echo "Deploying Home Manager configuration: ${NAME}"
    exec home-manager switch --flake "${FLAKE_PATH}#${NAME}"
    ;;
esac
